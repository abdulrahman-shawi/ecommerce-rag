# Local PostgreSQL connection. Update for your environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/storeflow?schema=public"
# Uncomment if using Prisma <5.10.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/storeflow?schema=public"

# Application URL used for Canva OAuth redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate a long random value, for example: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Optional Canva OAuth credentials. MockCanvaService is used when unset.
# CANVA_CLIENT_ID=""
# CANVA_CLIENT_SECRET=""
